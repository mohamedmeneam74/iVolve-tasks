@Library('ivolve-lib') _

pipeline {
    agent { label 'docker-agent' }          // runs on the Jenkins agent (Part B)

    environment {
        IMAGE_NAME = 'medomeneam/demoapp'      // CHECK: your Docker Hub username
        IMAGE_TAG  = "${env.BUILD_NUMBER}"
    }

    stages {
        stage('Checkout') {
            steps { checkout scm }
        }
        stage('Build App') {
            steps { buildApp() }
        }
        stage('Build Image') {
            steps {
                buildImage(imageName: env.IMAGE_NAME,
                           imageTag: env.IMAGE_TAG,
                           credentialsId: 'dockerhub-credentials')
            }
        }
        stage('Deploy on K8s') {
            steps {
                // GitOps (Lab 23): only update the manifest in GitHub.
                // Argo CD syncs it to the cluster, no kubectl apply here.
                deployOnK8s(imageName: env.IMAGE_NAME,
                            imageTag: env.IMAGE_TAG,
                            deploymentFile: 'k8s/deployment.yaml',
                            gitCredId: 'github-credentials')
            }
        }
    }

    post {
        always  { echo "Pipeline #${env.BUILD_NUMBER}: ${currentBuild.currentResult}"; deleteDir() }
        success { echo 'Manifest pushed to GitHub, Argo CD will sync it.' }
        failure { echo 'Pipeline failed.' }
    }
}

